{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stella://schemas/companion-policy-decision-v0.1",
  "title": "Stella Companion Policy Decision V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "decision",
    "reason_code",
    "authority_checked",
    "execution_authorized"
  ],
  "properties": {
    "proposal_id": {"type": "string"},
    "decision": {
      "type": "string",
      "enum": ["ALLOW", "DENY", "HOLD"]
    },
    "reason_code": {"type": "string"},
    "authority_checked": {"const": true},
    "execution_authorized": {"type": "boolean"},
    "executor_contract": {"type": ["string", "null"]},
    "receipt_ref": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {
        "properties": {"decision": {"enum": ["DENY", "HOLD"]}},
        "required": ["decision"]
      },
      "then": {
        "properties": {"execution_authorized": {"const": false}}
      }
    }
  ]
}
