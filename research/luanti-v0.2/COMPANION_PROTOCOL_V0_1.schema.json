{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stella://schemas/companion-protocol-v0.1",
  "title": "Stella Companion Proposal V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "actor_ref",
    "intent",
    "authority",
    "basis_refs",
    "requested_executor"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^proposal\\.[A-Za-z0-9._-]+$"
    },
    "actor_ref": {
      "type": "string",
      "pattern": "^actor\\.companion\\.[A-Za-z0-9._-]+$"
    },
    "intent": {
      "type": "string",
      "enum": [
        "observe",
        "follow_player",
        "wait",
        "come_here",
        "point_to_target",
        "lead_player"
      ]
    },
    "target_actor_ref": {
      "type": ["string", "null"],
      "pattern": "^actor\\.[A-Za-z0-9._-]+$"
    },
    "target_place_ref": {
      "type": ["string", "null"],
      "pattern": "^place\\.[A-Za-z0-9._-]+$"
    },
    "basis_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "authority": {
      "const": "PROPOSAL_ONLY"
    },
    "requested_executor": {
      "type": "string",
      "enum": ["none", "orient", "follow", "wait", "navigate"]
    },
    "context_packet_ref": {
      "type": ["string", "null"],
      "pattern": "^context\\.[A-Za-z0-9._-]+$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"intent": {"const": "lead_player"}},
        "required": ["intent"]
      },
      "then": {
        "required": ["target_place_ref"],
        "properties": {
          "target_place_ref": {
            "type": "string",
            "pattern": "^place\\.[A-Za-z0-9._-]+$"
          },
          "basis_refs": {"minItems": 1},
          "requested_executor": {"const": "navigate"}
        }
      }
    },
    {
      "if": {
        "properties": {"intent": {"const": "point_to_target"}},
        "required": ["intent"]
      },
      "then": {
        "anyOf": [
          {
            "required": ["target_actor_ref"],
            "properties": {"target_actor_ref": {"type": "string"}}
          },
          {
            "required": ["target_place_ref"],
            "properties": {"target_place_ref": {"type": "string"}}
          }
        ],
        "properties": {
          "requested_executor": {"const": "orient"}
        }
      }
    },
    {
      "if": {
        "properties": {"intent": {"const": "follow_player"}},
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "requested_executor": {"const": "follow"}
        }
      }
    },
    {
      "if": {
        "properties": {"intent": {"const": "wait"}},
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "requested_executor": {"const": "wait"}
        }
      }
    },
    {
      "if": {
        "properties": {"intent": {"const": "come_here"}},
        "required": ["intent"]
      },
      "then": {
        "required": ["target_actor_ref"],
        "properties": {
          "target_actor_ref": {
            "type": "string",
            "pattern": "^actor\\.[A-Za-z0-9._-]+$"
          },
          "requested_executor": {"const": "navigate"}
        }
      }
    },
    {
      "if": {
        "properties": {"intent": {"const": "observe"}},
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "requested_executor": {
            "enum": ["none", "orient"]
          }
        }
      }
    }
  ]
}
